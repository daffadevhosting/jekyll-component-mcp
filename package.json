{
  "name": "jekyll-component-mcp",
  "version": "1.1.0",
  "description": "AI-native development MCP server for Jekyll projects and reusable Liquid/SCSS/JavaScript components.",
  "homepage": "https://github.com/daffadevhosting/jekyll-component-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daffadevhosting/jekyll-component-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/daffadevhosting/jekyll-component-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jekyll-component-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".github/skills",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jekyll",
    "liquid",
    "scss",
    "components",
    "ai",
    "agent"
  ],
  "author": {
    "name": "daffadevhosting",
    "url": "https://github.com/daffadevhosting"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "jekyll-component-mcp": "^1.0.0",
    "yaml": "^2.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
